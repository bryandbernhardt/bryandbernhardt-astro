---
interface Props {
  lang?: 'en' | 'pt' | 'es';
}

const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/bryandbernhardt' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/bryandbernhardt' },
];

const footerText = {
  en: '© {year} Bryan Dietrich Bernhardt. All rights reserved.',
  pt: '© {year} Bryan Dietrich Bernhardt. Todos os direitos reservados.',
  es: '© {year} Bryan Dietrich Bernhardt. Todos los derechos reservados.',
};

const footerLabel = {
  en: 'Social links',
  pt: 'Links sociais',
  es: 'Enlaces sociales',
};

const socialLinkAria = {
  en: {
    GitHub: 'GitHub profile of Bryan Dietrich Bernhardt (opens in a new tab)',
    LinkedIn: 'LinkedIn profile of Bryan Dietrich Bernhardt (opens in a new tab)',
  },
  pt: {
    GitHub: 'Perfil do GitHub de Bryan Dietrich Bernhardt (abre em nova aba)',
    LinkedIn: 'Perfil do LinkedIn de Bryan Dietrich Bernhardt (abre em nova aba)',
  },
  es: {
    GitHub: 'Perfil de GitHub de Bryan Dietrich Bernhardt (se abre en una nueva pestaña)',
    LinkedIn: 'Perfil de LinkedIn de Bryan Dietrich Bernhardt (se abre en una nueva pestaña)',
  },
} as const;
---

<footer class="mt-auto w-full border-t border-zinc-200 dark:border-slate-800 bg-zinc-50 dark:bg-[#090d16] py-8">
  <div class="mx-auto flex w-full max-w-[68rem] flex-col items-center justify-between gap-4 px-4 text-center sm:flex-row sm:px-8 sm:text-left">
    <p class="text-xs text-zinc-700 dark:text-slate-300">
      {footerText[lang].replace('{year}', String(currentYear))}
    </p>

    <ul class="flex items-center gap-2 list-none" role="list" aria-label={footerLabel[lang]}>
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="group inline-flex min-h-[48px] items-center gap-1 rounded-sm px-3 py-2 text-xs font-medium text-zinc-700 dark:text-slate-300 transition-colors hover:bg-zinc-100 dark:hover:bg-[#182032] hover:text-zinc-950 dark:hover:text-slate-50"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialLinkAria[lang][link.label as keyof typeof socialLinkAria.en]}
            >
              <span>{link.label}</span>
              <span class="arrow-icon arrow-icon--diag" aria-hidden="true">
                <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M5 15 15 5M8.5 5H15v6.5" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>